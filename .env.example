NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET=replace-with-at-least-64-random-characters-before-production
SESSION_DAYS=14
SESSION_IDLE_MINUTES=15
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
BACKUP_RETENTION_DAYS=30

# Web Push: одна VAPID-пара для всех устройств, не менять при каждом деплое.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# Production behind Nginx:
# NODE_ENV=production
# HOST=127.0.0.1
# APP_ORIGIN=https://svoi-perevozki.ru
# TRUST_PROXY=1
