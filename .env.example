NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET=replace-with-at-least-64-random-characters-before-production
SESSION_DAYS=14
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
BACKUP_RETENTION_DAYS=30

# SMTP / уведомления о новых заявках
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
TO_EMAIL=

# Production behind Nginx:
# NODE_ENV=production
# HOST=127.0.0.1
# APP_ORIGIN=https://your-domain.ru
# TRUST_PROXY=1
